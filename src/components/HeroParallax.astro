---
import { proyects } from "../data/proyects";
---

<section
    id="proyects"
    class="hero-parallax-section antialiased perspective-midrange transform-3d"
>
    <div class="parallax-container">
        <div class="horiz-gallery-wrapper">
            <div class="horiz-gallery-strip">
                {
                    proyects.map((p) => (
                        <div
                            class:list={[
                                "product-card group",
                                p.type === "mobile"
                                    ? "product-card--mobile"
                                    : "product-card--desktop",
                            ]}
                            data-product-title={p.title}
                        >
                            <a
                                href={p.link}
                                class="project-link"
                            >
                                <img
                                    src={p.thumbnail}
                                    alt={p.title}
                                    class="project-image"
                                />
                            </a>
                            <div class="project-overlay" />
                            <h2 class="project-title">
                                {p.title}
                            </h2>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    .hero-parallax-section {
        position: relative;
        display: flex;
        flex-direction: column;
        padding-bottom: clamp(12rem, 30vw, 24rem);
    }

    .parallax-container {
        display: flex;
        margin-bottom: clamp(3rem, 8vw, 5rem);
        transform-style: preserve-3d;
        will-change: transform, opacity;
    }

    .horiz-gallery-wrapper {
        display: flex;
        position: relative;
        width: 100%;
        will-change: transform;
    }

    .horiz-gallery-strip {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: clamp(0.75rem, 2.5vw, 2.25rem);
        width: 100%;
        padding: clamp(2.5rem, 7vw, 5rem) clamp(0.75rem, 3vw, 3rem) 0;
        position: relative;
        will-change: transform, opacity;
    }

    .product-card {
        position: relative;
        flex: 0 0 auto;
        height: clamp(6rem, min(22vw, 30vh), 19rem);
        overflow: hidden;
        border-radius: clamp(0.5rem, 1vw, 0.9rem);
        transition: transform 300ms ease, box-shadow 300ms ease;
        will-change: transform;
    }

    .product-card--desktop {
        width: clamp(11rem, min(40vw, 55vh), 34rem);
    }

    .product-card--mobile {
        width: clamp(4.5rem, min(15vw, 22vh), 9rem);
    }

    .product-card:hover {
        z-index: 2;
        transform: scale(1.05);
        box-shadow: 0 1.5rem 3rem rgb(0 0 0 / 25%);
    }

    .project-link,
    .project-image {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: inherit;
    }

    .project-image {
        object-fit: cover;
        object-position: center;
    }

    .project-overlay {
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: black;
        opacity: 0;
        pointer-events: none;
        transition: opacity 300ms ease;
    }

    .project-title {
        position: absolute;
        bottom: clamp(0.5rem, 1.5vw, 1rem);
        left: clamp(0.5rem, 1.5vw, 1rem);
        margin: 0;
        color: white;
        font-size: clamp(0.65rem, 1.4vw, 1.25rem);
        line-height: 1.15;
        opacity: 0;
        pointer-events: none;
        transition: opacity 300ms ease;
    }

    .product-card:hover .project-overlay {
        opacity: 0.8;
    }

    .product-card:hover .project-title {
        opacity: 1;
    }

    @media (min-width: 64rem) {
        .product-card--desktop {
            width: clamp(20rem, 30vw, 34rem);
        }
    }

    @media (max-width: 30rem) {
        .horiz-gallery-strip {
            gap: 0.6rem;
        }

        .product-card--desktop {
            width: clamp(9.5rem, 42vw, 12rem);
        }

        .product-card--mobile {
            width: clamp(4rem, 14vw, 5.5rem);
        }
    }
</style>

<script>
    import gsap from "gsap";
    import ScrollTrigger from "gsap/ScrollTrigger";
    import ScrollSmoother from "gsap/ScrollSmoother";

    gsap.registerPlugin(ScrollTrigger, ScrollSmoother);

    let animationContext: gsap.Context | undefined;

    const clamp = (minimum: number, value: number, maximum: number) =>
        Math.min(maximum, Math.max(minimum, value));

    function destroyHeroParallax() {
        animationContext?.revert();
        animationContext = undefined;
    }

    function initHeroParallax() {
        destroyHeroParallax();

        const section = document.getElementById("proyects");
        const container = section?.querySelector<HTMLElement>(
            ".parallax-container",
        );
        const gallery = section?.querySelector<HTMLElement>(
            ".horiz-gallery-wrapper",
        );
        const strip = gallery?.querySelector<HTMLElement>(
            ".horiz-gallery-strip",
        );

        if (!section || !container || !gallery || !strip) return;

        if (!ScrollSmoother.get()) {
            ScrollSmoother.create({
                wrapper: "#smooth-wrapper",
                content: "#smooth-content",
                smooth: 2,
                normalizeScroll: true,
            });
        }

        const entryY = () =>
            -clamp(240, window.innerHeight * 0.56, 560);
        const settledY = () => {
            const viewportCenter = (window.innerHeight - container.offsetHeight) / 2;
            const headerClearance = clamp(24, window.innerHeight * 0.05, 64);

            return Math.max(headerClearance, viewportCenter);
        };
        const exitX = () => clamp(240, window.innerWidth * 0.82, 800);
        const holdDistance = () =>
            clamp(180, window.innerHeight * 0.32, 360);
        const slideDistance = () =>
            strip.scrollWidth + clamp(60, window.innerWidth * 0.08, 100);

        animationContext = gsap.context(() => {
            // Mantiene la entrada original: torcida, elevada y casi transparente.
            gsap.fromTo(
                container,
                {
                    rotateX: 40,
                    rotateZ: 30,
                    y: entryY,
                    autoAlpha: 0.1,
                },
                {
                    scrollTrigger: {
                        trigger: section,
                        start: "top center",
                        end: "top top",
                        scrub: true,
                        invalidateOnRefresh: true,
                    },
                    rotateX: 0,
                    rotateZ: 0,
                    y: settledY,
                    autoAlpha: 1,
                    ease: "none",
                },
            );

            // Al llegar al centro, conserva el encuadre antes de iniciar la salida.
            const hold = holdDistance();
            const slide = slideDistance();
            const exitTimeline = gsap.timeline({
                scrollTrigger: {
                    trigger: section,
                    pin: section,
                    pinSpacing: false,
                    start: "top top",
                    end: () => `+=${holdDistance() + slideDistance()}`,
                    scrub: true,
                    anticipatePin: 1,
                    invalidateOnRefresh: true,
                },
            });

            exitTimeline
                .to(strip, {
                    x: 0,
                    autoAlpha: 1,
                    duration: hold,
                    ease: "none",
                })
                .to(strip, {
                    x: exitX,
                    autoAlpha: -0.5,
                    duration: slide,
                    ease: "none",
                });

            for (const image of strip.querySelectorAll("img")) {
                if (!image.complete) {
                    image.addEventListener(
                        "load",
                        () => ScrollTrigger.refresh(),
                        { once: true },
                    );
                }
            }
        }, section);

        ScrollTrigger.refresh();
    }

    const onPageLoad = () => initHeroParallax();
    const onBeforeSwap = () => destroyHeroParallax();

    document.addEventListener("astro:page-load", onPageLoad);
    document.addEventListener("astro:before-swap", onBeforeSwap);
    initHeroParallax();

    if (import.meta.hot) {
        import.meta.hot.dispose(() => {
            document.removeEventListener("astro:page-load", onPageLoad);
            document.removeEventListener("astro:before-swap", onBeforeSwap);
            destroyHeroParallax();
        });
    }
</script>
