---
import "../styles/globals.css";
import { ClientRouter } from "astro:transitions";
import Header from "./Header.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="Web portfolio for my, I'm a full stack software developer"
        />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
        <script
            src="https://cdn.jsdelivr.net/npm/emojione@4.0.0/lib/js/emojione.min.js"
        ></script>
        <link
            rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/emojione@4.0.0/extras/css/emojione.min.css"
        />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <ClientRouter />
    </head>
    <body class="from-primary/10 via-base-100 to-secondary/15 bg-linear-to-b">
        <Header />
        <main class="overflow-hidden">
            <slot />
        </main>
    </body>
</html>
